<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">#FFF8EF</item>
        <item name="android:navigationBarColor">#FFF8EF</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>

    <style name="AppStartingTheme" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#FF7A00</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_logo</item>
        <item name="windowSplashScreenIconBackgroundColor">#00000000</item>
        <item name="windowSplashScreenAnimationDuration">0</item>
        <item name="postSplashScreenTheme">@style/AppTheme</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">#FF7A00</item>
        <item name="android:navigationBarColor">#FF7A00</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>
</resources>
